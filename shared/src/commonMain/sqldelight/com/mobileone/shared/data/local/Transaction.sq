-- Tabela de transações financeiras (SPEC-002 / ADR-002).
-- Nome "AccountTransaction" evita conflito com a palavra reservada TRANSACTION do SQLite.
-- epochDay = número de dias desde 1970-01-01, para agrupamento por data sem APIs de locale.
CREATE TABLE AccountTransaction (
    id TEXT NOT NULL PRIMARY KEY,
    accountId TEXT NOT NULL,
    amountCents INTEGER NOT NULL,
    isDebit INTEGER NOT NULL,       -- 1 = débito, 0 = crédito (SQLite não tem Boolean nativo)
    description TEXT NOT NULL,
    category TEXT NOT NULL,
    epochDay INTEGER NOT NULL
);

CREATE INDEX idx_account_transaction_account_epochDay
ON AccountTransaction (accountId, epochDay DESC);

insertAccountTransaction:
INSERT OR IGNORE INTO AccountTransaction (id, accountId, amountCents, isDebit, description, category, epochDay)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAccountTransactionPage:
SELECT * FROM AccountTransaction
WHERE accountId = :accountId
ORDER BY epochDay DESC, id DESC
LIMIT :pageSize OFFSET :offset;

selectRecentAccountTransactions:
SELECT * FROM AccountTransaction
WHERE accountId = :accountId
ORDER BY epochDay DESC, id DESC
LIMIT :limit;

countAccountTransactions:
SELECT COUNT(*) FROM AccountTransaction WHERE accountId = :accountId;
